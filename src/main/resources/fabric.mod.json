{
  "schemaVersion": 1,
  "id": "conquest",
  "version": "${version}",
  "name": "Conquest HUD",
  "description": "Conquest MMO UI",
  "authors": [],
  "contact": {},
  "license": "CC0-1.0",
  "icon": "assets/conquest-hud/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.conquest.hud.ConquestHud"
    ],
    "client": [
      "com.conquest.hud.client.ConquestHudClient"
    ],
    "cardinal-components-entity": [
      "com.conquest.hud.core.stats.StatsComponentRegistry",
      "com.conquest.hud.core.container.ContainerComponentRegistry"
    ]
  },
  "custom": {
    "cardinal-components": [
      "conquest:player_stats",
      "conquest:progression",
      "conquest:stamina",
      "conquest:player_weight",
      "conquest:player_containers"
    ]
  },
  "mixins": [
    "conquest-hud.mixins.json",
    {
      "config": "conquest-hud.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}